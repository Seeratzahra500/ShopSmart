# MongoDB connection string
MONGO_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=

# Frontend origin(s) allowed by CORS
CLIENT_URL=http://localhost:3000
CLIENT_URL_PROD=
CLIENT_URL_PROD2=

# Existing password-reset email sender (server/src/utils/email.js)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Order lifecycle emails (server/src/utils/mailer.js) — OPTIONAL.
# Leave SMTP_HOST unset to disable order emails entirely (safe default for
# dev and for the Jest suite); sends become a no-op when unconfigured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Misc
NODE_ENV=development
PORT=5000
ADMIN_EMAIL=admin@shopsmart.com
ADMIN_PASSWORD=

# Set to "true" to force Secure cookies outside production (see server/src/utils/cookies.js)
SECURE_COOKIES=
